---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../consts';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const rendered = await Promise.all(
  services.map(async (s) => ({ entry: s, Content: (await render(s)).Content }))
);

const FAQ = [
  {
    q: 'How much does a website cost?',
    a: 'A straightforward business site with up to about ten pages typically lands between AED 4,500 and AED 12,000, depending on how much of the content and imagery you already have. WooCommerce stores and anything with custom functionality are quoted individually. You get a fixed price before work starts, not an hourly estimate that drifts.',
  },
  {
    q: 'How long does it take?',
    a: 'Two to six weeks for most sites. The variable is almost never the build — it is how quickly content, logos and approvals come back. Projects where the client has their content ready finish at the fast end of that range.',
  },
  {
    q: 'Do you work with clients outside the UAE?',
    a: 'Yes. I have supported clients internationally for years and most of the work happens remotely regardless. For UAE clients I can meet in person in Dubai when it helps.',
  },
  {
    q: 'Can you fix a site someone else built?',
    a: 'Usually, and it is a large part of what I do — inherited WordPress sites, broken migrations, malware cleanups, sites that lost their rankings after a redesign. I will look at it first and tell you honestly whether repairing or rebuilding is the better use of your money.',
  },
  {
    q: 'How long before SEO shows results?',
    a: 'Technical fixes can move things within weeks. Competitive rankings take three to six months of consistent work. Anyone promising page one in thirty days is either lying or planning to do something that will get you penalised.',
  },
  {
    q: 'Do I own the website when we finish?',
    a: 'Completely. Domain, hosting, code, and every credential are in your name and handed over. I do not hold anything hostage — if you want to move to another developer, you can, and I will help with the transition.',
  },
  {
    q: 'What happens after launch?',
    a: 'Thirty days of support is included with every build. After that, maintenance is optional — a monthly retainer covering updates, backups, security and small changes. Plenty of clients handle it themselves, and I will show you how.',
  },
];

const schema = [
  {
    '@type': 'FAQPage',
    '@id': `${SITE.url}/services#faq`,
    mainEntity: FAQ.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: { '@type': 'Answer', text: item.a },
    })),
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
      { '@type': 'ListItem', position: 2, name: 'Services', item: `${SITE.url}/services` },
    ],
  },
];
---

<BaseLayout
  title="Services"
  description="Web development, technical SEO, IT support and security for Dubai businesses. Fixed scope, clear pricing, and full ownership handed over at the end."
  image="/og/page/services.png"
  schema={schema}
>
  <header class="container-page pt-16 md:pt-24">
    <div class="max-w-3xl">
      <p class="eyebrow mb-5" data-reveal>// Services</p>
      <h1 class="text-[clamp(2.5rem,7vw,4.5rem)]" data-reveal>
        Scoped, priced,<br /><span class="text-accent">and handed over.</span>
      </h1>
      <p class="mt-6 text-lg leading-relaxed text-muted" data-reveal style="--reveal-delay:100ms">
        Four services. Each one comes with a written scope, a fixed price or a clear
        rate, and an explicit list of what is not included — because that is the part
        that causes arguments later.
      </p>
    </div>
  </header>

  <!-- Service detail sections -->
  <div class="container-page section space-y-px">
    {
      rendered.map(({ entry, Content }, i) => (
        <section
          id={entry.id}
          class="scroll-mt-[calc(var(--header-h)+2rem)] border-t border-line pt-14 first:border-t-0 first:pt-0 md:pt-20"
          data-reveal
        >
          <div class="grid gap-10 lg:grid-cols-[1fr_1.15fr] lg:gap-16">
            <div class="lg:sticky lg:top-[calc(var(--header-h)+2rem)] lg:self-start">
              <p class="font-mono text-xs text-accent">0{i + 1}</p>
              <h2 class="mt-3 text-[clamp(1.9rem,4vw,2.75rem)]">{entry.data.title}</h2>
              <p class="mt-4 text-[1.05rem] leading-relaxed text-muted">{entry.data.tagline}</p>

              <dl class="mt-7 space-y-3 border-t border-line pt-6 font-mono text-sm">
                {entry.data.startingPrice && (
                  <div class="flex justify-between gap-4">
                    <dt class="text-faint">Starting at</dt>
                    <dd class="text-accent">{entry.data.startingPrice}</dd>
                  </div>
                )}
                {entry.data.timeline && (
                  <div class="flex justify-between gap-4">
                    <dt class="text-faint">Typical timeline</dt>
                    <dd>{entry.data.timeline}</dd>
                  </div>
                )}
              </dl>

              <a href="/contact" class="btn btn-ghost mt-7 inline-flex">
                Enquire about this
              </a>
            </div>

            <div>
              <div class="prose max-w-none">
                <Content />
              </div>

              <div class="mt-9 grid gap-6 sm:grid-cols-2">
                <div>
                  <h3 class="font-mono text-[11px] uppercase tracking-[0.16em] text-faint">
                    What's involved
                  </h3>
                  <ul class="mt-4 space-y-2.5 text-sm text-muted">
                    {entry.data.bullets.map((b) => (
                      <li class="flex gap-2.5">
                        <span class="mt-[7px] size-1.5 shrink-0 rotate-45 bg-accent" aria-hidden="true" />
                        <span>{b}</span>
                      </li>
                    ))}
                  </ul>
                </div>

                {entry.data.deliverables.length > 0 && (
                  <div>
                    <h3 class="font-mono text-[11px] uppercase tracking-[0.16em] text-faint">
                      What you get
                    </h3>
                    <ul class="mt-4 space-y-2.5 text-sm text-muted">
                      {entry.data.deliverables.map((d) => (
                        <li class="flex gap-2.5">
                          <svg
                            viewBox="0 0 24 24"
                            class="mt-[3px] size-4 shrink-0 text-accent"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2.2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            aria-hidden="true"
                          >
                            <path d="m5 12 5 5L20 7" />
                          </svg>
                          <span>{d}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                )}
              </div>
            </div>
          </div>
        </section>
      ))
    }
  </div>

  <!-- FAQ -->
  <section class="section border-t border-line" aria-labelledby="faq-heading">
    <div class="container-page">
      <div class="grid gap-12 lg:grid-cols-[1fr_1.5fr] lg:gap-16">
        <div data-reveal>
          <p class="eyebrow mb-5">// Questions</p>
          <h2 id="faq-heading" class="text-[clamp(2rem,5vw,3rem)]">
            The things<br />everyone asks
          </h2>
          <p class="mt-5 text-muted">
            Answered honestly, including the ones where the answer is inconvenient
            for me.
          </p>
        </div>

        <div class="divide-y divide-[var(--border)] border-y border-line">
          {
            FAQ.map((item, i) => (
              <details class="group" data-reveal style={`--reveal-delay:${i * 50}ms`}>
                <summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-5 text-[1.05rem] font-medium transition-colors hover:text-accent">
                  {item.q}
                  <span
                    class="relative grid size-6 shrink-0 place-items-center text-accent"
                    aria-hidden="true"
                  >
                    <span class="absolute h-px w-3.5 bg-current" />
                    <span class="absolute h-3.5 w-px bg-current transition-transform duration-300 group-open:rotate-90 group-open:opacity-0" />
                  </span>
                </summary>
                <p class="pb-6 pr-10 leading-relaxed text-muted">{item.a}</p>
              </details>
            ))
          }
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
