---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../consts';

export async function getStaticPaths() {
  const entries = await getCollection('work', ({ data }) => !data.draft);
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

interface Props {
  entry: CollectionEntry<'work'>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, client, summary, cover, coverAlt, services, stack, metrics, year, url } = entry.data;

// Unconfirmed metrics are hidden from visitors but surfaced as a build-time
// reminder in dev, so placeholders cannot quietly become permanent.
const realMetrics = metrics.filter((m) => m.value && m.value.toUpperCase() !== 'TODO');
const pendingMetrics = metrics.length - realMetrics.length;

const pageUrl = new URL(`/work/${entry.id}`, Astro.site).href;

const schema = [
  {
    '@type': 'CreativeWork',
    '@id': `${pageUrl}#work`,
    name: title,
    about: client,
    description: summary,
    dateCreated: year,
    author: { '@id': `${SITE.url}/#person` },
    url: pageUrl,
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
      { '@type': 'ListItem', position: 2, name: 'Work', item: `${SITE.url}/work` },
      { '@type': 'ListItem', position: 3, name: title, item: pageUrl },
    ],
  },
];

const allWork = (await getCollection('work', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order
);
const currentIndex = allWork.findIndex((w) => w.id === entry.id);
const next = allWork[(currentIndex + 1) % allWork.length];
---

<BaseLayout
  title={title}
  description={summary}
  image={`/og/work/${entry.id}.png`}
  schema={schema}
>
  <article>
    <header class="container-page pt-14 md:pt-20">
      <nav aria-label="Breadcrumb" class="mb-8">
        <ol class="flex items-center gap-2 font-mono text-xs text-faint">
          <li><a href="/" class="transition-colors hover:text-accent">Home</a></li>
          <li aria-hidden="true">/</li>
          <li><a href="/work" class="transition-colors hover:text-accent">Work</a></li>
        </ol>
      </nav>

      <div class="max-w-4xl">
        <p class="font-mono text-xs uppercase tracking-[0.16em] text-accent">
          {client} · {year}
        </p>
        <h1 class="mt-4 text-[clamp(2.2rem,5.5vw,3.75rem)]">{title}</h1>
        <p class="mt-6 max-w-2xl text-lg leading-relaxed text-muted">{summary}</p>

        {
          url && (
            <a
              href={url}
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-ghost mt-7 inline-flex"
            >
              Visit the site
              <svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                <path d="M7 17 17 7M9 7h8v8" />
              </svg>
            </a>
          )
        }
      </div>

      {
        cover && (
          <div class="mt-12 overflow-hidden rounded-xl border border-line">
            <Image
              src={cover}
              alt={coverAlt ?? `${client} — ${title}`}
              widths={[600, 1000, 1600]}
              sizes="100vw"
              class="w-full"
              loading="eager"
            />
          </div>
        )
      }
    </header>

    <!-- Metrics band -->
    {
      realMetrics.length > 0 && (
        <div class="container-page mt-14">
          <dl class="grid gap-px overflow-hidden rounded-xl border border-line bg-line sm:grid-cols-2 lg:grid-cols-4">
            {realMetrics.map((m, i) => (
              <div class="bg-bg p-7" data-reveal style={`--reveal-delay:${i * 80}ms`}>
                <dd class="font-display text-[2.6rem] leading-none text-accent">{m.value}</dd>
                <dt class="mt-3 font-mono text-[11px] uppercase tracking-[0.14em] text-faint">
                  {m.label}
                </dt>
              </div>
            ))}
          </dl>
        </div>
      )
    }

    <!-- Body + sidebar -->
    <div class="container-page mt-16">
      <div class="grid gap-12 lg:grid-cols-[minmax(0,1fr)_17rem] lg:gap-16">
        <div class="prose">
          <Content />
        </div>

        <aside class="order-first lg:order-last">
          <div class="card p-6 lg:sticky lg:top-[calc(var(--header-h)+2rem)]">
            <p class="font-mono text-[11px] uppercase tracking-[0.16em] text-faint">Engagement</p>
            <dl class="mt-4 space-y-4 text-sm">
              <div>
                <dt class="text-muted">Client</dt>
                <dd class="mt-0.5 font-medium">{client}</dd>
              </div>
              <div>
                <dt class="text-muted">Period</dt>
                <dd class="mt-0.5 font-medium">{year}</dd>
              </div>
              {
                services.length > 0 && (
                  <div>
                    <dt class="text-muted">Services</dt>
                    <dd class="mt-2 flex flex-wrap gap-1.5">
                      {services.map((s) => (
                        <span class="tag">{s}</span>
                      ))}
                    </dd>
                  </div>
                )
              }
              {
                stack.length > 0 && (
                  <div>
                    <dt class="text-muted">Stack</dt>
                    <dd class="mt-2 flex flex-wrap gap-1.5">
                      {stack.map((s) => (
                        <span class="tag">{s}</span>
                      ))}
                    </dd>
                  </div>
                )
              }
            </dl>

            <a href="/contact" class="btn btn-primary mt-6 w-full !py-3 !text-[13px]">
              Discuss a similar project
            </a>
          </div>
        </aside>
      </div>
    </div>

    <!-- Next case study -->
    {
      next && next.id !== entry.id && (
        <div class="container-page section">
          <a
            href={`/work/${next.id}`}
            class="group flex flex-wrap items-center justify-between gap-6 border-t border-line pt-10"
          >
            <div>
              <p class="font-mono text-xs uppercase tracking-[0.14em] text-faint">Next case study</p>
              <h2 class="mt-2 text-2xl transition-colors group-hover:text-accent md:text-3xl">
                {next.data.title}
              </h2>
            </div>
            <svg
              viewBox="0 0 24 24"
              class="size-8 shrink-0 text-accent transition-transform duration-300 group-hover:translate-x-2"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M5 12h14M13 6l6 6-6 6" />
            </svg>
          </a>
        </div>
      )
    }
  </article>

  {
    /* Dev-only nudge so unconfirmed metrics get resolved before launch. */
    import.meta.env.DEV && pendingMetrics > 0 && (
      <div class="container-page pb-10">
        <p class="rounded-lg border border-yellow-500/40 bg-yellow-500/10 p-4 font-mono text-xs text-yellow-600 dark:text-yellow-400">
          DEV NOTE — {pendingMetrics} metric{pendingMetrics === 1 ? '' : 's'} on this case study
          still say "TODO" and are hidden from visitors. Fill them in or remove them from the
          frontmatter.
        </p>
      </div>
    )
  }
</BaseLayout>
