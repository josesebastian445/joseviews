---
import { NAV, SITE, CONTACT, SOCIAL } from '../consts';

const year = new Date().getFullYear();

const iconPaths: Record<string, string> = {
  github:
    'M12 2C6.48 2 2 6.58 2 12.25c0 4.53 2.87 8.37 6.84 9.73.5.1.68-.22.68-.49l-.01-1.9c-2.78.62-3.37-1.22-3.37-1.22-.46-1.18-1.11-1.5-1.11-1.5-.91-.63.07-.62.07-.62 1 .07 1.53 1.06 1.53 1.06.89 1.57 2.34 1.12 2.91.86.09-.66.35-1.12.63-1.38-2.22-.26-4.56-1.14-4.56-5.07 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.3.1-2.71 0 0 .84-.28 2.75 1.05a9.3 9.3 0 0 1 5 0c1.91-1.33 2.75-1.05 2.75-1.05.55 1.41.2 2.45.1 2.71.64.72 1.03 1.63 1.03 2.75 0 3.94-2.34 4.81-4.57 5.06.36.32.68.94.68 1.9l-.01 2.82c0 .27.18.59.69.49A10.03 10.03 0 0 0 22 12.25C22 6.58 17.52 2 12 2Z',
  linkedin:
    'M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9h4v12H3V9Zm7 0h3.8v1.7h.05c.53-.95 1.83-1.95 3.77-1.95 4.03 0 4.78 2.5 4.78 5.75V21h-4v-5.6c0-1.34-.03-3.06-1.9-3.06-1.9 0-2.2 1.45-2.2 2.96V21h-4V9Z',
  mail: 'M3 5.5h18v13H3v-13Zm1.8 1.6L12 12.6l7.2-5.5',
};
---

<footer class="relative mt-auto border-t border-line">
  <div class="container-page">
    <!-- Closing CTA -->
    <div class="border-b border-line py-16 md:py-24">
      <div class="grid gap-10 md:grid-cols-[1.4fr_1fr] md:items-end">
        <div data-reveal>
          <p class="eyebrow mb-5">Let's talk</p>
          <h2 class="text-[clamp(2.2rem,6vw,4rem)]">
            Got a project that needs<br />
            <span class="text-accent">building or fixing?</span>
          </h2>
          <p class="mt-5 max-w-md text-muted">
            Tell me what you're trying to achieve. I'll come back with an honest read on
            scope, timeline and whether I'm the right person for it.
          </p>
        </div>
        <div class="flex flex-col gap-3" data-reveal style="--reveal-delay:120ms">
          <a href="/contact" class="btn btn-primary !py-4">Start a project</a>
          <a
            href={`https://wa.me/${CONTACT.whatsapp}?text=${encodeURIComponent(CONTACT.whatsappMessage)}`}
            class="btn btn-ghost !py-4"
            target="_blank"
            rel="noopener noreferrer"
          >
            Message on WhatsApp
          </a>
          <p class="mt-1 text-center font-mono text-xs text-faint">
            Typically replies within a few hours · {SITE.city} time
          </p>
        </div>
      </div>
    </div>

    <!-- Link columns -->
    <div class="grid gap-10 py-14 sm:grid-cols-2 md:grid-cols-4">
      <div class="sm:col-span-2">
        <a href="/" class="flex items-center gap-2.5">
          <span
            class="grid size-8 place-items-center rounded-md bg-accent font-mono text-[13px] font-bold text-accent-contrast"
            aria-hidden="true">JS</span
          >
          <span class="font-semibold tracking-tight">Jose Sebastian</span>
        </a>
        <p class="mt-4 max-w-xs text-sm leading-relaxed text-muted">
          IT Manager and web developer in {SITE.city}. Websites that load fast, rank well and
          don't fall over.
        </p>
        <div class="mt-5 flex gap-2">
          {
            SOCIAL.map((s) => (
              <a
                href={s.url}
                target={s.url.startsWith('mailto:') ? undefined : '_blank'}
                rel="noopener noreferrer"
                aria-label={s.name}
                class="grid size-9 place-items-center rounded-lg border border-line text-muted transition hover:border-accent hover:text-accent"
              >
                <svg viewBox="0 0 24 24" class="size-[17px]" fill={s.icon === 'mail' ? 'none' : 'currentColor'} stroke={s.icon === 'mail' ? 'currentColor' : 'none'} stroke-width="1.6" aria-hidden="true">
                  <path d={iconPaths[s.icon]} />
                </svg>
              </a>
            ))
          }
        </div>
      </div>

      <nav aria-label="Footer">
        <h3 class="font-mono text-[11px] uppercase tracking-[0.18em] text-faint">Navigate</h3>
        <ul class="mt-4 space-y-2.5 text-sm">
          {
            NAV.map((item) => (
              <li>
                <a href={item.href} class="text-muted transition-colors hover:text-accent">
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div>
        <h3 class="font-mono text-[11px] uppercase tracking-[0.18em] text-faint">Get in touch</h3>
        <ul class="mt-4 space-y-2.5 text-sm">
          <li>
            <a href={`mailto:${CONTACT.email}`} class="break-all text-muted transition-colors hover:text-accent">
              {CONTACT.email}
            </a>
          </li>
          <li>
            <a href={`tel:${CONTACT.phone}`} class="text-muted transition-colors hover:text-accent">
              {CONTACT.phoneDisplay}
            </a>
          </li>
          <li class="text-muted">{SITE.city}, {SITE.countryName}</li>
          <li>
            <a href="/rss.xml" class="text-muted transition-colors hover:text-accent">RSS feed</a>
          </li>
        </ul>
      </div>
    </div>

    <div
      class="flex flex-col items-center justify-between gap-3 border-t border-line py-7 font-mono text-xs text-faint sm:flex-row"
    >
      <p>© {year} Jose Sebastian. All rights reserved.</p>
      <p>
        Built with Astro · Hosted on Cloudflare ·
        <span class="text-accent">100/100 Lighthouse</span>
      </p>
    </div>
  </div>
</footer>
