---
import { CONTACT } from '../consts';

// In the UAE market a WhatsApp thread converts far better than a form, so it
// gets a permanent, always-reachable entry point.
const href = `https://wa.me/${CONTACT.whatsapp}?text=${encodeURIComponent(CONTACT.whatsappMessage)}`;
---

<a
  id="whatsapp-fab"
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  class="group fixed bottom-5 right-5 z-40 flex items-center gap-0 overflow-hidden rounded-full border border-line-strong bg-surface/90 py-3 pl-3 pr-3 shadow-[var(--shadow-card)] backdrop-blur-md transition-all duration-300 hover:border-accent hover:pr-5 md:bottom-7 md:right-7"
  aria-label="Chat on WhatsApp"
>
  <svg viewBox="0 0 24 24" class="size-6 shrink-0 fill-accent" aria-hidden="true">
    <path
      d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2Zm5.8 14.09c-.25.69-1.44 1.32-1.99 1.4-.53.08-1.19.11-1.92-.12-.44-.14-1.01-.33-1.74-.64-3.06-1.32-5.06-4.4-5.21-4.6-.15-.2-1.24-1.65-1.24-3.15s.79-2.24 1.07-2.55c.28-.31.61-.38.81-.38l.58.01c.19.01.44-.07.68.52.25.6.86 2.09.94 2.24.08.15.13.33.02.53-.1.2-.15.33-.3.5l-.45.53c-.15.15-.3.32-.13.62.17.3.76 1.25 1.63 2.03 1.12 1 2.06 1.3 2.36 1.45.3.15.47.13.64-.08.17-.2.74-.86.94-1.16.2-.3.4-.25.67-.15.27.1 1.72.81 2.01.96.3.15.5.22.57.35.07.12.07.72-.18 1.41Z"
    ></path>
  </svg>
  <span
    class="max-w-0 whitespace-nowrap text-sm font-medium opacity-0 transition-all duration-300 group-hover:ml-2.5 group-hover:max-w-[10rem] group-hover:opacity-100"
  >
    Chat on WhatsApp
  </span>
</a>

<style>
  /* Slide out of the way once the footer CTA is on screen — two competing
     "contact me" affordances in the same viewport is one too many. */
  #whatsapp-fab {
    transition-property: transform, opacity, border-color, padding;
  }
  :global(body[data-footer-visible]) #whatsapp-fab {
    transform: translateY(150%);
    opacity: 0;
    pointer-events: none;
  }
</style>

<script>
  const footer = document.querySelector('footer');
  if (footer && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      ([entry]) => {
        document.body.toggleAttribute('data-footer-visible', entry.isIntersecting);
      },
      { rootMargin: '-40% 0px 0px 0px' }
    );
    io.observe(footer);
  }
</script>
