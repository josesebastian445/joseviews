---
import type { CollectionEntry } from 'astro:content';

interface Props {
  service: CollectionEntry<'services'>;
  index?: number;
}

const { service, index = 0 } = Astro.props;
const { title, tagline, icon, bullets, startingPrice } = service.data;

// Inline paths keep icons at zero network cost and let them inherit currentColor.
const ICONS: Record<string, string> = {
  code: 'M8 6 2 12l6 6M16 6l6 6-6 6M13.5 4l-3 16',
  search: 'M11 19a8 8 0 1 0 0-16 8 8 0 0 0 0 16ZM21 21l-4.35-4.35',
  shield: 'M12 22s8-3.6 8-10V5.5L12 2 4 5.5V12c0 6.4 8 10 8 10Z M9 12l2 2 4-4',
  server:
    'M3 5h18v6H3V5Zm0 8h18v6H3v-6Zm4-5h.01M7 16h.01M11 8h6M11 16h6',
};
---

<article
  class="card group relative flex h-full flex-col overflow-hidden p-7 transition-colors duration-300 hover:border-accent/50"
  data-reveal
  style={`--reveal-delay:${index * 90}ms`}
>
  <!-- Hover wash -->
  <span
    class="pointer-events-none absolute inset-x-0 -top-24 h-40 bg-accent/10 opacity-0 blur-3xl transition-opacity duration-500 group-hover:opacity-100"
    aria-hidden="true"></span>

  <div class="relative flex items-start justify-between gap-4">
    <span
      class="grid size-11 shrink-0 place-items-center rounded-xl border border-line bg-surface-2/70 text-accent transition-colors duration-300 group-hover:border-accent/50"
      aria-hidden="true"
    >
      <svg
        viewBox="0 0 24 24"
        class="size-5"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d={ICONS[icon]} />
      </svg>
    </span>
    <span class="font-mono text-xs text-faint">0{index + 1}</span>
  </div>

  <h3 class="relative mt-5 text-2xl">{title}</h3>
  <p class="relative mt-2.5 text-[0.95rem] leading-relaxed text-muted">{tagline}</p>

  <ul class="relative mt-5 space-y-2.5 text-sm text-muted">
    {
      bullets.slice(0, 4).map((b) => (
        <li class="flex gap-2.5">
          <svg
            viewBox="0 0 24 24"
            class="mt-[3px] size-4 shrink-0 text-accent"
            fill="none"
            stroke="currentColor"
            stroke-width="2.2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="m5 12 5 5L20 7" />
          </svg>
          <span>{b}</span>
        </li>
      ))
    }
  </ul>

  <div class="relative mt-auto flex items-center justify-between gap-4 pt-7">
    {
      startingPrice && (
        <span class="font-mono text-xs text-faint">{startingPrice}</span>
      )
    }
    <a
      href={`/services#${service.id}`}
      class="inline-flex items-center gap-1.5 text-sm font-medium text-accent"
    >
      Details
      <svg
        viewBox="0 0 24 24"
        class="size-3.5 transition-transform duration-300 group-hover:translate-x-1"
        fill="none"
        stroke="currentColor"
        stroke-width="2.2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M5 12h14M13 6l6 6-6 6" />
      </svg>
      <span class="sr-only">about {title}</span>
    </a>
  </div>
</article>
