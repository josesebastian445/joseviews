---
interface Props {
  date: Date;
  /** 'short' → 5 Aug 2026 · 'long' → 5 August 2026 */
  format?: 'short' | 'long';
}

const { date, format = 'short' } = Astro.props;

const formatted = new Intl.DateTimeFormat('en-GB', {
  day: 'numeric',
  month: format === 'long' ? 'long' : 'short',
  year: 'numeric',
  timeZone: 'UTC',
}).format(date);
---

<time datetime={date.toISOString()}>{formatted}</time>
