---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'work'>;
  index?: number;
  /** First card on the work index spans the full width. */
  featured?: boolean;
}

const { entry, index = 0, featured = false } = Astro.props;
const { title, client, summary, cover, coverAlt, services, metrics, year } = entry.data;

// Only surface metrics that have a confirmed value — placeholders stay hidden
// rather than shipping "TODO" to a visitor.
const realMetrics = metrics.filter((m) => m.value && m.value.toUpperCase() !== 'TODO');
---

<article
  class:list={[
    'card tilt group relative flex flex-col overflow-hidden transition-colors duration-300 hover:border-accent/50',
    featured && 'md:col-span-2',
  ]}
  data-tilt={featured ? '2' : '3'}
  data-reveal
  style={`--reveal-delay:${index * 45}ms`}
>
  <a href={`/work/${entry.id}`} class="flex h-full flex-col">
    <div class="relative aspect-[16/9] overflow-hidden border-b border-line bg-surface-2">
      {
        cover ? (
          <Image
            src={cover}
            alt={coverAlt ?? `${client} — ${title}`}
            widths={[480, 800, 1200]}
            sizes="(min-width: 1024px) 45vw, 100vw"
            class="size-full object-cover transition-transform duration-700 group-hover:scale-[1.04]"
            loading={index < 2 ? 'eager' : 'lazy'}
          />
        ) : (
          <div class="grid size-full place-items-center">
            <span class="font-mono text-5xl text-faint/40" aria-hidden="true">
              {client
                .split(' ')
                .map((w) => w[0])
                .slice(0, 3)
                .join('')}
            </span>
          </div>
        )
      }
      <span
        class="absolute left-4 top-4 rounded-md border border-line bg-bg/80 px-2.5 py-1 font-mono text-[11px] backdrop-blur-md"
      >
        {year}
      </span>
    </div>

    <div class="flex flex-1 flex-col p-6">
      <p class="font-mono text-xs uppercase tracking-[0.14em] text-accent">{client}</p>
      <h3 class="mt-2.5 text-2xl leading-tight">{title}</h3>
      <p class="mt-3 line-clamp-3 text-[0.95rem] leading-relaxed text-muted">{summary}</p>

      {
        realMetrics.length > 0 && (
          <dl class="mt-5 flex flex-wrap gap-x-8 gap-y-3 border-t border-line pt-5">
            {realMetrics.slice(0, 3).map((m) => (
              <div>
                <dd class="font-display text-2xl leading-none text-accent">{m.value}</dd>
                <dt class="mt-1.5 font-mono text-[10px] uppercase tracking-[0.12em] text-faint">
                  {m.label}
                </dt>
              </div>
            ))}
          </dl>
        )
      }

      <div class="mt-auto flex flex-wrap gap-1.5 pt-6">
        {services.slice(0, 4).map((s) => <span class="tag">{s}</span>)}
      </div>
    </div>
  </a>
</article>
