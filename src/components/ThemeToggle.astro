---
/**
 * Three-state theme control: an explicit choice is stored, and with no stored
 * choice the OS preference wins. Dispatches a `themechange` event so the
 * canvas background can re-read its palette instantly.
 */
---

<button
  type="button"
  id="theme-toggle"
  class="grid size-9 place-items-center rounded-lg border border-line text-muted transition hover:border-accent hover:text-accent"
  aria-label="Switch between light and dark theme"
>
  <svg
    class="size-[18px] dark-icon"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.6"
    stroke-linecap="round"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
  </svg>
  <svg
    class="size-[18px] light-icon"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.6"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path>
  </svg>
</button>

<style>
  /* Show the icon for the theme you would switch *to*. */
  .light-icon {
    display: none;
  }
  :global(:root[data-theme='light']) .light-icon {
    display: block;
  }
  :global(:root[data-theme='light']) .dark-icon {
    display: none;
  }
  @media (prefers-color-scheme: light) {
    :global(:root:not([data-theme='dark'])) .light-icon {
      display: block;
    }
    :global(:root:not([data-theme='dark'])) .dark-icon {
      display: none;
    }
  }
</style>

<script>
  const btn = document.getElementById('theme-toggle');

  const currentTheme = () => {
    const explicit = document.documentElement.getAttribute('data-theme');
    if (explicit) return explicit;
    return window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
  };

  btn?.addEventListener('click', () => {
    const next = currentTheme() === 'dark' ? 'light' : 'dark';
    document.documentElement.setAttribute('data-theme', next);
    try {
      localStorage.setItem('theme', next);
    } catch {
      /* private mode — the choice just will not persist */
    }
    document.dispatchEvent(new CustomEvent('themechange', { detail: next }));
  });
</script>
