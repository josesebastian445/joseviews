# Copy to .env for local development. Never commit the real .env.
#
# Only PUBLIC_-prefixed variables are exposed to the browser. Everything the
# contact form needs to actually send mail lives in Cloudflare Pages, not here
# — see DEPLOYMENT.md.

# Cloudflare Turnstile site key (public half). Leave empty to disable the
# bot-verification widget entirely; the form still works without it.
PUBLIC_TURNSTILE_SITE_KEY=
